{
  "name": "reviewloop",
  "version": "0.4.1",
  "private": true,
  "description": "A managed single-host service for persistent author and reviewer sessions with GitHub, GitLab and Arcadia.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  },
  "bin": {
    "reviewctl": "scripts/reviewctl.mjs"
  },
  "files": [
    "dist",
    "scripts/reviewctl.mjs",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts serve --demo",
    "ui": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/cli.js serve",
    "reviewctl": "tsx src/cli.ts",
    "format": "prettier --write src tests scripts docs *.json *.ts *.md .github .gitlab-ci.yml",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.md .github .gitlab-ci.yml",
    "release:build": "npm run build && node scripts/build-release.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "commander": "^15.0.0",
    "fastify": "^5.12.3",
    "ink": "^7.1.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "string-width": "^8.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/xterm": "^6.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
