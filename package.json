{
  "name": "daddyloop",
  "version": "0.13.0",
  "private": true,
  "description": "daddy manages a pool of workers, workspaces and native code reviews from one conversation.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  },
  "bin": {
    "daddy": "scripts/daddy.mjs"
  },
  "files": [
    "dist",
    "scripts/daddy.mjs",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts serve --demo",
    "ui": "vite --host 127.0.0.1",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run docs:check",
    "start": "node dist/server/cli.js serve",
    "daddy": "tsx src/cli.ts",
    "format": "prettier --write src tests scripts docs *.json *.ts *.md .github .gitlab-ci.yml",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.md .github .gitlab-ci.yml",
    "release:build": "npm run build && node scripts/build-release.mjs",
    "speech:prepare": "node scripts/prepare-speech.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "commander": "^15.0.0",
    "fastify": "^5.12.3",
    "ink": "^7.1.1",
    "lucide-react": "^1.42.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "ogg-opus-decoder": "1.7.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "string-width": "^8.2.2",
    "tar": "7.5.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/xterm": "^6.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
